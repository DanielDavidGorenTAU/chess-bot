<View>
  <View style="display: flex; justify-content: space-between; padding: 10px; background: #f3f4f6; border-radius: 5px; margin-bottom: 10px;">
    
    <View>
      <Header value="1. Select Piece State &amp; Draw Box" size="4"/>
      <RectangleLabels name="piece_class" toName="img">
        <Label value="Standing" background="#007BFF"/>
        <Label value="Lying" background="#FFC107"/>
      </RectangleLabels>
    </View>

    <View>
      <Header value="2. Place Keypoints" size="4"/>
      <KeyPointLabels name="keypoints" toName="img">
        <Label value="Head" background="#FF0000"/>
        <Label value="Base" background="#00FF00"/>
      </KeyPointLabels>
    </View>
    
  </View>

  <Image name="img" value="$image" zoom="true" zoomControl="true"/>
</View>